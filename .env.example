# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริงจาก Supabase
# (ไฟล์ .env จะไม่ถูก push ขึ้น git เพราะอยู่ใน .gitignore)

# Project Settings → Data API → Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Project Settings → API Keys → service_role (secret!) — ใช้ฝั่ง server เท่านั้น
SUPABASE_SERVICE_KEY=eyJhbGciOi...
